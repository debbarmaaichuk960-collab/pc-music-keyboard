
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Voice typing permission -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Keyboard vibration permission -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Voice recognition service visibility -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="PC Music Keyboard"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">

        <!-- Main app activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Keyboard theme settings -->
        <activity
            android:name=".ThemeActivity"
            android:exported="false"
            android:label="Keyboard Theme" />

        <!-- PC Music Keyboard input method -->
        <service
            android:name=".PCKeyboardService"
            android:label="PC Music Keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">

            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />

        </service>

    </application>

</manifest>
